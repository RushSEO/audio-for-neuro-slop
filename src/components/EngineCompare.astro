---
/** Врезка «Point of interest»: на какие движки заменить голос и сколько стоят 1000 слов. Данные — src/data/tts-engines.json */
import data from "../data/tts-engines.json";
interface Props { current?: string }
const current = Astro.props.current ?? data.current;
const max = Math.max(...data.engines.map((e) => e.usd));
const money = (e: { usd: number; approx?: boolean }) =>
  e.usd === 0 ? "$0" : `${e.approx ? "~" : ""}$${e.usd.toFixed(2)}`;
const checked = new Date(data.checked).toLocaleDateString("ru-RU", { day: "numeric", month: "long", year: "numeric" });
---

<aside class="poi" aria-labelledby="poi-title">
  <div class="poi-head">
    <span class="poi-eyebrow">Point of interest</span>
    <h2 id="poi-title" class="poi-title">Чем заменить голос и сколько это стоит</h2>
    <p class="poi-lead">{current === "espeak" && "Озвучено бесплатным espeak, поэтому голос роботизированный. "}Скрипт переключается на любой движок из таблицы одной переменной <code>TTS_ENGINE</code>. Цена указана за 1000 слов, как в этой аудиоверсии.</p>
  </div>

  <div class="poi-scroll">
    <table class="poi-table">
      <thead>
        <tr><th scope="col">Движок</th><th scope="col" class="num">1000 слов</th><th scope="col">Что важно</th></tr>
      </thead>
      <tbody>
        {data.engines.map((e) => (
          <tr class:list={{ "is-current": e.id === current, "is-warn": e.warn }}>
            <th scope="row">
              <span class="poi-vendor">{e.vendor}</span>
              <span class="poi-model">{e.model}</span>
            </th>
            <td class="num">
              <span class="poi-price">{money(e)}</span>
              <span class="poi-bar" aria-hidden="true"><i style={`width:${max ? (e.usd / max) * 100 : 0}%`}></i></span>
              <span class="poi-tariff">{e.tariff}</span>
            </td>
            <td class="poi-note">
              {e.id === current && <span class="poi-tag">сейчас здесь</span>}
              {e.warn && <span class="poi-tag poi-tag-warn">устаревает</span>}
              {e.note}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="poi-foot">{data.basis}. Цены по официальным прайсам ElevenLabs, Google Cloud и OpenAI на {checked}; «~» — оценка по длительности для движков с оплатой за аудиотокены.</p>
</aside>

<style>
  .poi {
    margin: 0 0 40px; padding: 20px 22px 16px;
    border: 1px solid var(--line); border-radius: 16px;
    background: linear-gradient(var(--poi-bg), var(--poi-bg)), var(--surface);
    font-family: var(--sans);
  }
  .poi-head { display: grid; gap: 6px; margin-bottom: 14px; }
  .poi-eyebrow {
    justify-self: start; padding: 3px 8px; border-radius: 6px;
    background: var(--accent); color: var(--on-accent);
    font: 700 10.5px/1.3 var(--mono); letter-spacing: .08em; text-transform: uppercase;
  }
  .poi-title { margin: 4px 0 0; font: 700 22px/1.25 var(--serif); text-wrap: balance; }
  .poi-lead { margin: 0; font-size: 14.5px; line-height: 1.5; color: var(--muted); max-width: 62ch; }
  .poi-lead code { font: 12.5px var(--mono); padding: 1px 5px; border-radius: 4px; background: var(--hover); color: var(--fg); }

  .poi-scroll { overflow-x: auto; margin: 0 -6px; }
  .poi-table { width: 100%; border-collapse: collapse; font-size: 14px; }
  .poi-table thead th {
    padding: 0 6px 8px; text-align: left; border-bottom: 1px solid var(--line);
    font: 600 10.5px/1.3 var(--mono); letter-spacing: .06em; text-transform: uppercase; color: var(--muted);
  }
  .poi-table td, .poi-table tbody th { padding: 9px 6px; border-bottom: 1px solid var(--line); vertical-align: top; text-align: left; font-weight: 400; }
  .poi-table tbody tr:last-child > * { border-bottom: 0; }
  .poi-table .num { text-align: right; white-space: nowrap; }
  .poi-vendor { display: block; font-weight: 650; }
  .poi-model { display: block; font-size: 12.5px; color: var(--muted); }
  .poi-price { display: block; font: 650 15px/1.3 var(--mono); font-variant-numeric: tabular-nums; }
  .poi-bar { display: block; width: 72px; height: 4px; margin: 4px 0 3px auto; border-radius: 2px; background: var(--track); overflow: hidden; }
  .poi-bar i { display: block; height: 100%; margin-left: auto; background: var(--accent); }
  .poi-tariff { display: block; font-size: 11.5px; color: var(--muted); }
  .poi-note { line-height: 1.45; min-width: 180px; }
  .poi-tag {
    display: inline-block; margin: 0 6px 2px 0; padding: 1px 7px; border-radius: 999px;
    background: var(--speak); color: var(--fg); font: 600 11px/1.5 var(--sans); vertical-align: 1px;
  }
  .poi-tag-warn { background: var(--warn-bg); color: var(--warn-fg); }
  .poi-table tr.is-current > * { background: color-mix(in srgb, var(--speak) 45%, transparent); }

  .poi-foot { margin: 12px 0 0; font-size: 12px; line-height: 1.5; color: var(--muted); }

  @media (max-width: 520px) {
    .poi { padding: 16px 14px 12px; }
    .poi-title { font-size: 19px; }
    .poi-tariff { display: none; }
  }
</style>
